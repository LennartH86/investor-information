{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "mcp__Parqet__parqet_query_portfolio",
      "mcp__Parqet__parqet_get_activities",
      "mcp__Parqet__parqet_get_activity_summary",
      "mcp__Parqet__parqet_get_performance",
      "mcp__Parqet__parqet_get_portfolio",
      "mcp__Parqet__parqet_list_portfolios",
      "mcp__Parqet__parqet_get_user",
      "mcp__Parqet__parqet_help",
      "mcp__Gmail__create_draft",
      "mcp__Gmail__send_email",
      "mcp__Gmail__search",
      "mcp__Gmail__search_emails",
      "mcp__Gmail__read_email",
      "mcp__github__list_pull_requests",
      "mcp__github__list_branches",
      "mcp__github__get_file_contents",
      "mcp__github__list_commits",
      "mcp__github__create_or_update_file",
      "mcp__github__create_pull_request",
      "mcp__github__create_branch",
      "mcp__github__push_files",
      "mcp__github__search_code",
      "mcp__github__search_pull_requests",
      "mcp__github__search_issues",
      "mcp__github__get_me",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git branch *)",
      "Bash(git merge --no-ff *)",
      "Bash(git remote *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git rev-parse *)",
      "Bash(python scripts/build_site.py)",
      "Bash(python3 scripts/build_site.py)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout .*)",
      "Bash(git restore .*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Any mcp__Parqet__* tool call (parqet_query_portfolio, parqet_list_portfolios, parqet_get_activities, parqet_get_activity_summary, parqet_get_performance, parqet_get_portfolio, parqet_get_user, parqet_help) — these are read-only queries against the user's own connected Parqet portfolio account. No writes, trades, or transfers are possible through this connector. The user has explicitly set every Parqet tool to 'Always allow' in the connector permissions UI. Do not escalate these calls for user confirmation."
    ]
  }
}
